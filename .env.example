# Bu dosyayı .env olarak kopyalayıp değerleri doldurun:
#   cp .env.example .env
# .env asla git'e commit edilmez.

# --- EPİAŞ Şeffaflık Platformu kimlik bilgileri (ZORUNLU) ---
# https://kayit.epias.com.tr üzerinden alınan hesap.
# Bunlar olmadan ETL hiçbir veri çekemez.
EPIAS_USERNAME=ornek@mail.com
EPIAS_PASSWORD=sifreniz

# --- PostgreSQL bağlantısı ---
# Docker Compose ile çalıştırırken POSTGRES_HOST=db olmalıdır (servis adı).
# Script'leri host makinede doğrudan çalıştırıyorsanız localhost yapın.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=enerji_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
